---
import Icon from './Icon.astro';
import CmsLink from './CmsLink.astro';
import MenuItems from './MenuItems.astro';
import { safeUrl } from '../lib/sanitize.mjs';
const { settings } = Astro.props;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Hobsons Bay Chess Club home"><img src={safeUrl(settings.logo)} alt="Hobsons Bay Chess Club" width="80" height="80" /></a>
  <div class="header-actions">
    {settings.headerSocialLinks.map(item=><CmsLink item={item} class="social-link" aria-label={item.label}><Icon name={item.icon}/></CmsLink>)}
    <button class="menu-toggle" aria-label="Open menu" aria-haspopup="dialog" aria-controls="site-menu"><span></span><span></span><span></span></button>
  </div>
</header>
<dialog id="site-menu" class="site-menu" aria-label="Site navigation">
  <div class="menu-heading"><a href="/">{settings.menuLabel}</a><button class="menu-close" aria-label="Close menu">×</button></div>
  <nav aria-label="Main navigation">
    <MenuItems items={settings.mainMenu.items}/>
  </nav>
  <p class="menu-contact"><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const opener = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const close = document.querySelector<HTMLButtonElement>('.menu-close');
  opener?.addEventListener('click', () => { dialog?.showModal(); document.documentElement.classList.add('menu-open'); });
  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
  dialog?.addEventListener('close', () => { document.documentElement.classList.remove('menu-open'); opener?.focus(); });
</script>
