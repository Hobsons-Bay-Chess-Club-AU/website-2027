---
const { name = 'arrow', class: className = '' } = Astro.props;
const glyphs = { chess:'\uf439',pawn:'\uf443',board:'\uf43c',membership:'\uf2bb',history:'\uf1da',people:'\uf0c0',junior:'\uf1ae',calendar:'\uf073',events:'\uf091',attendance:'\uf500' };
---
{glyphs[name] ? <span class={`chess-icon ${className}`} aria-hidden="true">{glyphs[name]}</span> : name === 'instagram' ? (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor"/></svg>
) : name === 'facebook' ? (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 22v-9h3l.5-4H14V7c0-1.2.3-2 2-2h2V1.4C17.2 1.2 16.2 1 15 1c-3 0-5 1.8-5 5v3H7v4h3v9z"/></svg>
) : name === 'youtube' ? (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 6.2c-.2-.9-.9-1.6-1.8-1.8C18.3 4 12 4 12 4s-6.3 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 7.7 2 12 2 12s0 4.3.4 5.8c.2.9.9 1.6 1.8 1.8C5.7 20 12 20 12 20s6.3 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-5.8.4-5.8s0-4.3-.4-5.8zM10 16V8l7 4-7 4z"/></svg>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M8 12h8m-3-3 3 3-3 3"/></svg>
)}
