---
import CmsLink from './CmsLink.astro';
import Icon from './Icon.astro';
import {siteUrl as safeUrl} from '../lib/site-url.mjs';
const {card}=Astro.props;
---
{card.presentation==='faq'?<details class="club-faq" id={card.anchor}><summary>{card.title}</summary><div set:html={card.bodyHtml}/></details>:<article id={card.anchor} class:list={['cms-card',{'cms-timeline':card.presentation==='timeline','cms-pricing-card':card.presentation==='pricing','cms-step-card':card.presentation==='step','cms-profile-card':card.presentation==='profile','cms-roster-card':card.presentation==='roster'}]}>{card.eyebrow&&<p class="eyebrow">{card.eyebrow}</p>}{card.image&&<img src={safeUrl(card.image)} alt={card.imageAlt||''} loading="lazy" decoding="async"/>}{card.icon&&card.icon!=='none'&&<Icon name={card.icon} class="card-icon"/>}<h3>{card.title}</h3>{card.description&&<p>{card.description}</p>}{card.presentation==='pricing'&&card.price&&<p class="cms-price">{card.price}</p>}{card.bodyHtml&&<div class="cms-rich-text" set:html={card.bodyHtml}/>}<CmsLink item={card.link} class={card.presentation==='pricing'?'button button-dark':'text-link'}/></article>}
