---
import Icon from './Icon.astro';
import CmsLink from './CmsLink.astro';
import ContentCard from './ContentCard.astro';
import NewsCards from './NewsCards.astro';
import ResultsEvents from './ResultsEvents.astro';
import Calendar from './Calendar.astro';
import PolicyList from './PolicyList.astro';
import {siteUrl as safeUrl} from '../lib/site-url.mjs';
import {approvedEmbed} from '../lib/render-rich-text.mjs';
const {sections=[],settings,posts=[]}=Astro.props;
---
{sections.map(section=>section.kind==='statistics'?(
 <section id={section.anchor} class="stats-section" aria-label={section.title||section.internalName}><div class="container stats-grid">{section.statistics.map(stat=><div><Icon name={stat.icon} class="stat-icon"/><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>
):section.kind==='leaderboardEvents'?<ResultsEvents section={section}/>:section.kind==='feature'?(
 <section id={section.anchor} class="weekly-feature" style={"--weekly-image:url('"+safeUrl(section.image)+"')"}><div class="container"><div class="weekly-copy"><h2>{section.title}</h2><p>{section.subtitle}</p><div set:html={section.bodyHtml}/>{section.actions.map(action=><CmsLink item={action} class="button button-gold"/>)}</div></div></section>
):section.kind==='schedule'?(
 <section id={section.anchor} class="section section-light"><div class="container"><div class="section-heading"><h2>{section.title}</h2>{section.actions.map(action=><CmsLink item={action} class="text-link"/>)}</div><div class="schedule-grid">{section.days.map(day=><div class:list={['schedule-day',{'schedule-active':day.sessions.length>0}]}><h3>{day.day}</h3>{day.sessions.length?day.sessions.map(session=><div><span>{session.time}</span><h4>{session.title}</h4><p>{session.location}</p><CmsLink item={session.link}/></div>):<p>{day.closedText}</p>}</div>)}</div></div></section>
):section.kind==='sponsors'?(
 <section id={section.anchor} class="section sponsors-section"><div class="container"><h2 class="center-heading">{section.title}</h2><div class="sponsor-grid">{section.sponsors.map(sponsor=><a class="sponsor-logo" href={safeUrl(sponsor.website)} aria-label={sponsor.name}><img src={safeUrl(sponsor.image)} alt={sponsor.name} width="320" height="170" loading="lazy" decoding="async"/></a>)}</div></div></section>
):section.kind==='news'?(
 <section id={section.anchor} class="section section-light"><div class="container"><div class="section-heading"><h2>{section.title}</h2>{section.actions.map(action=><CmsLink item={action} class="text-link"/>)}</div><NewsCards posts={(section.posts.length?section.posts:posts).slice(0,section.limit||3)} settings={settings}/></div></section>
):section.kind==='calendar'?(
 <section id={section.anchor} class="section section-light"><div class="container">{section.title&&<h2>{section.title}</h2>}<Calendar schedule={section.calendar}/>{section.actions.length>0&&<div class="cms-actions">{section.actions.map(action=><CmsLink item={action} class="button button-gold"/>)}</div>}</div></section>
):section.kind==='quote'?(
 <section id={section.anchor} class="testimonial"><div class="container"><span aria-hidden="true">“</span><blockquote><div set:html={section.bodyHtml}/></blockquote>{section.eyebrow&&<p>{section.eyebrow}</p>}</div></section>
):section.kind==='cta'?(
 <section id={section.anchor} class="join-banner"><div class="container join-content"><div>{section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}<h2>{section.title}</h2></div>{section.subtitle&&<CmsLink item={section.actions[1]} class="join-contact"><span>{section.subtitle}</span><div set:html={section.bodyHtml}/></CmsLink>}<CmsLink item={section.actions[0]} class="button button-dark"/></div></section>
):(
 <section id={section.anchor} class:list={['cms-section','section','cms-tone-'+(section.tone||'light'),'cms-layout-'+(section.layoutStyle||'default')]}><div class="container">{section.title&&<h2>{section.title}</h2>}{section.subtitle&&<p class="section-introduction">{section.subtitle}</p>}{section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
 {section.image&&<img class="cms-feature-image" src={safeUrl(section.image)} alt={section.imageAlt||''} loading="lazy"/>}
 <div class="cms-rich-text" set:html={section.bodyHtml}/>
 {section.kind==='columns'&&<div class="cms-columns">{section.children.map(child=><div><Astro.self sections={[child]} settings={settings} posts={posts}/></div>)}</div>}
 {(section.kind==='cards'||section.kind==='accordion')&&<div class:list={{'cms-card-grid':section.kind==='cards','cms-accordion':section.kind==='accordion'}}>{section.cards.map(card=><ContentCard card={card}/>)}</div>}
 {section.kind==='policies'&&<PolicyList policies={section.policies}/>}
 {section.kind==='gallery'&&<div class="cms-gallery">{section.gallery.map(photo=><figure>{photo.link?<CmsLink item={photo.link}><img src={safeUrl(photo.image)} alt={photo.alt} loading="lazy"/></CmsLink>:<img src={safeUrl(photo.image)} alt={photo.alt} loading="lazy"/>}{section.layoutStyle==='affiliations'&&<figcaption>{photo.title}</figcaption>}</figure>)}</div>}
 {section.kind==='embed'&&approvedEmbed(section.embedUrl)&&<iframe class="club-embed" src={approvedEmbed(section.embedUrl)} title={section.title||section.internalName} loading="lazy"/>}
 {section.actions.length>0&&<div class="cms-actions">{section.actions.map(action=><CmsLink item={action} class="button button-gold"/>)}</div>}
 </div></section>
))}
