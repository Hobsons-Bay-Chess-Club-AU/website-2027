---
import Layout from '../layouts/Layout.astro';
import Sections from '../components/Sections.astro';
import {getContent} from '../lib/content.mjs';
import {safeUrl} from '../lib/sanitize.mjs';
export async function getStaticPaths(){
 const {pages,posts}=await getContent();
 return [...pages.map(page=>({params:{slug:page.slug},props:{page,isPost:false}})),...posts.map(page=>({params:{slug:page.slug},props:{page,isPost:true}}))];
}
const {page,isPost}=Astro.props;
const {settings,posts}=await getContent();
const hero=page.heroImage||page.image||settings.heroImage;
---
<Layout title={page.title} seoTitle={page.seoTitle} description={page.description||page.excerpt} image={hero} noindex={page.noindex}>
 <section class="page-hero" style={"--page-image:url('"+safeUrl(hero)+"')"}><div class="container"><a class="breadcrumb" href={isPost?'/news/':'/'}>{isPost?settings.newsLabel:settings.homeLabel} <span aria-hidden="true">/</span></a><h1>{page.heroTitle||page.title}</h1>{(page.heroDescription||page.description)&&<p>{page.heroDescription||page.description}</p>}{isPost&&<p><time datetime={page.publishedAt}>{new Intl.DateTimeFormat('en-AU',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(page.publishedAt))}</time>{page.author&&<span> · {page.author}</span>}</p>}</div></section>
 {isPost?<article class="cms-section post-content cms-tone-light" aria-label={page.title}><div class="cms-rich-text" set:html={page.bodyHtml}/></article>:<div class="cms-page-content"><Sections sections={page.sections} settings={settings} posts={posts}/></div>}
</Layout>
