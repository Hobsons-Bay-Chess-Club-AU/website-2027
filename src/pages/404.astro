---
import Layout from '../layouts/Layout.astro';
import {siteUrl} from '../lib/site-url.mjs';
if(import.meta.env.SITE_DEPLOY_TARGET==='vercel')Astro.response.status=404;
---
<Layout title="Page not found" noindex><section class="not-found container"><p class="eyebrow">404</p><h1>That move is off the board.</h1><p>We couldn't find this page. Explore the club from the homepage.</p><a class="button button-gold" href={siteUrl('/')}>Back to HBCC</a></section></Layout>
