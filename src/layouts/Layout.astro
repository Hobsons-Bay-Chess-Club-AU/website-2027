---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content.mjs';
import { siteUrl as safeUrl } from '../lib/site-url.mjs';
import '../styles/global.css';
import '../styles/review.css';
import '../styles/content-layouts.css';
const { settings } = await getContent();
const { title = settings.title, seoTitle, description = settings.defaultDescription, image = settings.heroImage, home = false, noindex = false } = Astro.props;
const staging = import.meta.env.SITE_STAGING === 'true';
const review = settings.reviewVersion === 'v2';
const currentUrl = review ? new URL('../',new URL(safeUrl('/'),Astro.site)).href : null;
const canonical = new URL(Astro.url.pathname === safeUrl('/404/') ? safeUrl('/404.html') : Astro.url.pathname, Astro.site);
const pageTitle = seoTitle || (home ? `${settings.shortName} | ${settings.title}` : `${title} | ${settings.title}`);
const absoluteImage = new URL(safeUrl(image || settings.heroImage), Astro.site).href;
const structured = { '@context':'https://schema.org', '@type':'SportsClub', name:settings.title, url:new URL(safeUrl('/'),Astro.site).href, email:settings.email, address:settings.address, image:absoluteImage };
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b0a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={safeUrl(settings.favicon || settings.logo)} />
    <link rel="stylesheet" href={safeUrl('/fonts/hbcc-fonts.css')} />
    {home && <link rel="preload" as="image" href={safeUrl(settings.heroImage)} />}
    <meta property="og:type" content="website" /><meta property="og:site_name" content={settings.title} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {(noindex || staging || review) && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')} />
  </head>
  <body class:list={{ 'home-page': home, 'review-layout': review }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {review&&<aside class="review-banner" aria-label="Team review version"><div><strong>V2 · Team review</strong><span>Proposed website changes</span></div><div><a href={safeUrl('/review/')}>Changes & checklist</a><a href={currentUrl} data-current-version>Current version ↗</a></div></aside>}
    <Header settings={settings} />
    <main id="main"><slot /></main>
    <Footer settings={settings} />
  </body>
</html>
