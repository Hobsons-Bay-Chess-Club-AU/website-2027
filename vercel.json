{
  "framework": "astro",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "regions": ["syd1"],
  "redirects": [
    {"source":"/blog/:path*","destination":"/news/","permanent":true},
    {"source":"/author/boldthemes/:path*","destination":"/news/","permanent":true},
    {"source":"/category/hbcc-chess/:path*","destination":"/news/","permanent":true},
    {"source":"/about/club-history/:path*","destination":"/history/","permanent":true}
  ],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}]
}
