# Your existing names are supported. Keep this file free of real tokens.
CONTENTFUL_SPACEID=
CONTENTFUL_DELIVERY_API=
CONTENTFUL_PREVIEW_API=
CONTENTFUL_ENVIRONMENT=master
# Only used by the explicit migration script, never by the website.
CONTENTFUL_MANAGEMENT_TOKEN=
# auto: verified empty space uses reference; contentful: require a complete CMS;
# reference: explicitly use the saved local snapshot.
CONTENT_SOURCE=auto
# Local editorial preview only. Production builds refuse to include draft content.
CONTENTFUL_USE_PREVIEW=false
# Hosting: set by GitHub Pages automatically. Local defaults use the club domain.
SITE_URL=https://hobsonsbaychess.com
SITE_BASE_PATH=/
SITE_STAGING=false
