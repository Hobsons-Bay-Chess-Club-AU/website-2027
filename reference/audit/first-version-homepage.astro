---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../lib/content.mjs';
import { safeUrl } from '../lib/sanitize.mjs';
const { settings, events, sponsors, posts } = await getContent();
const eventDate = date => ({ day: new Intl.DateTimeFormat('en-AU',{ day:'2-digit', timeZone:'Australia/Melbourne' }).format(new Date(date)), month: new Intl.DateTimeFormat('en-AU',{ month:'short', timeZone:'Australia/Melbourne' }).format(new Date(date)) });
---
<Layout home>
  <section class="home-hero" style={`--hero-image:url('${safeUrl(settings.heroImage)}')`} aria-labelledby="home-heading">
    <div class="container hero-inner">
      <div class="hero-top">
        <div class="hero-introduction">
          <div class="hero-copy"><h1 id="home-heading">{settings.heroTitle}<span>{settings.heroStrapline}</span></h1><p>{settings.heroDescription}</p></div>
          <div class="hero-buttons"><a class="button button-outline" href={safeUrl(settings.portalUrl)}>View Tournaments</a><a class="button button-gold" href="/membership/">Become a Member</a></div>
        </div>
        <a class="hero-partner" href="/sponsors/" aria-label="Our proud partner Alkassab Dental Surgery"><img src={safeUrl(settings.partnerImage)} alt="Proud Partner — Alkassab Dental Surgery" width="716" height="426" fetchpriority="high" /></a>
      </div>
      <div class="hero-features">{settings.features.map(feature=><a class="feature-card" href={safeUrl(feature.href)}><Icon name={feature.icon} class="feature-icon" /><h2>{feature.title}</h2><div class="feature-caption"><Icon name="arrow" /><p>{feature.description}</p></div></a>)}</div>
    </div>
  </section>
  <section class="stats-section" aria-label="The club in numbers"><div class="container stats-grid">{settings.stats.map(stat=><div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>
  <section class="section section-light"><div class="container results-events">
    <div class="standings"><div class="section-heading"><div><h2>{settings.standings.title}</h2><p>{settings.standings.subtitle}</p></div><a class="text-link" href={safeUrl(settings.standings.url)}>Full Table <span aria-hidden="true">↗</span></a></div><div class="table-scroll"><table><caption class="sr-only">{settings.standings.subtitle} standings</caption><thead><tr><th scope="col">#</th><th scope="col">Players</th><th scope="col">Points</th></tr></thead><tbody>{settings.standings.rows.map(row=><tr>{row.map((cell,index)=>index===1?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div></div>
    <div><div class="section-heading"><h2>Events</h2><a class="text-link" href={safeUrl(settings.portalUrl)}>All Events <span aria-hidden="true">↗</span></a></div><div class="event-list">{events.map(event=>{const date=eventDate(event.startsAt);return <a class="event-card" href={safeUrl(event.registerUrl)}><div class="event-date"><strong>{date.day}</strong><span>{date.month}</span></div>{event.image&&<img src={safeUrl(event.image)} alt="" width="70" height="85" loading="lazy" decoding="async" />}<div><h3>{event.title}</h3><p>{event.detail}</p></div><span class="event-arrow" aria-hidden="true">↗</span></a>;})}</div></div>
  </div></section>
  <section class="weekly-feature" style={`--weekly-image:url('${safeUrl(settings.weeklyImage)}')`}><div class="container"><div class="weekly-copy"><h2>Weekly club nights and range of players</h2><p>Club nights, social chess and tournaments for adults and juniors</p><a class="button button-gold" href="/play-chess/">Play Chess with HBCC <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section section-light"><div class="container"><div class="section-heading"><h2>Typical Weekly Schedule</h2><a class="text-link" href={safeUrl(settings.scheduleUrl)}>View Schedule <span aria-hidden="true">→</span></a></div><div class="schedule-grid">{settings.schedule.map(day=><div class:list={['schedule-day',{'schedule-active':day.sessions.length>0}]}><h3>{day.day}</h3>{day.sessions.length?day.sessions.map(session=><div><span>{session.time}</span><h4>{session.title}</h4><p>Hobsons Bay Chess Club</p></div>):<p>Closed. No Chess</p>}</div>)}</div></div></section>
  <section class="section sponsors-section"><div class="container"><h2 class="center-heading">Our Sponsors &amp; Partners</h2><div class="sponsor-grid">{sponsors.map(sponsor=><a class="sponsor-logo" href={safeUrl(sponsor.website)} aria-label={sponsor.name}><img src={safeUrl(sponsor.image)} alt={sponsor.name} width="320" height="170" loading="lazy" decoding="async" /></a>)}</div></div></section>
  {posts.length>0&&<section class="section section-light"><div class="container"><div class="section-heading"><h2>Latest from HBCC</h2><a class="text-link" href="/news/">All News <span aria-hidden="true">→</span></a></div><div class="news-grid">{posts.slice(0,3).map(post=><a class="news-card" href={`/${post.slug}/`}>{post.image&&<img src={safeUrl(post.image)} alt="" width="600" height="400" loading="lazy" decoding="async" />}<div><time datetime={post.publishedAt}>{new Intl.DateTimeFormat('en-AU',{day:'numeric',month:'long',timeZone:'UTC'}).format(new Date(post.publishedAt))}</time><h3>{post.title}</h3><span class="text-link">Read more <span aria-hidden="true">→</span></span></div></a>)}</div></div></section>}
  <section class="testimonial"><div class="container"><span aria-hidden="true">“</span><blockquote>It is an awesome experience and coaches make it so much fun that you don't know you're even learning.</blockquote></div></section>
</Layout>
