    "contentful:import": "node scripts/import-contentful.mjs",
    "contentful:prepare": "node scripts/prepare-content.mjs && node scripts/prepare-cms-content.mjs && node scripts/prepare-model.mjs",
    "cms:preview": "node scripts/run-astro.mjs cms-preview",
    "verify": "node scripts/verify-build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "cheerio": "^1.2.0",
    "sanitize-html": "^2.18.0"
  },
